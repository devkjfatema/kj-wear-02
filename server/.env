# প্রথমবার চালালে এই ফাইল থেকে আপনা-আপনি .env তৈরি হয় (পাসওয়ার্ড নিজে বসে যায়)।
PORT=3000
# সাইটের আসল URL (পেমেন্ট কলব্যাকের জন্য দরকার)। লোকাল: http://localhost:3000
BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kjwear

ADMIN_USER=admin
ADMIN_PASS=162c154a00d5
SESSION_SECRET=8afe61955070cc445ec62dca1ebd7c4eb8cf4de2d750c99a

# bKash Tokenized Checkout (খালি রাখলে ম্যানুয়াল মোড চলবে)
BKASH_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# SSLCommerz (Visa/Mastercard ও অন্যান্য। খালি রাখলে কার্ড "শীঘ্রই" দেখাবে)
SSLCZ_SANDBOX=true
SSLCZ_STORE_ID=
SSLCZ_STORE_PASS=
